# Copy to .env (or run `npm run setup`, which writes it for you).

# ---- Core ----
PORT=8787
# Long random string. The glasses app sends it on every connection.
SHELL_TOKEN=change-me
# The public HTTPS address of this relay (your Cloudflare Tunnel hostname).
PUBLIC_URL=https://shell.example.com
# 1 = fake sessions and data, no API keys needed. Good for trying the UI.
DEMO=0

# ---- Claude ----
# login (default): sessions use your Claude Code login on this Mac, which also brings your claude.ai
#   connectors (Gmail, Calendar, Drive, Slack…). Check with `claude` → /status.
# token: use one of the two below instead (a server with no login). Connectors don't load this way.
CLAUDE_AUTH=login
# Option A: your Claude subscription. Run `claude setup-token` and paste the token.
CLAUDE_CODE_OAUTH_TOKEN=
# Option B: an API key from console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override for sessions (blank = Claude Code default).
CLAUDE_MODEL=
# Small fast model for the "how's everything going?" summary.
STATUS_MODEL=haiku

# ---- Repos ----
# Folder that holds your git repos. Each subfolder with a .git shows up on the lens.
REPOS_DIR=~/code
# Where per-session git worktrees go.
WORKTREES_DIR=~/.claude-shell/worktrees
# Where the relay keeps its state (rules, tokens, contacts).
DATA_DIR=~/.claude-shell/data

# ---- Dictation cleanup for replies (optional) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ---- 2FA codes (optional, opt-in; read docs/TWO_FACTOR.md first) ----
# Encrypts the imported secrets on disk. Not stored anywhere else: losing it means re-importing.
TOTP_PASSPHRASE=
# Swipe pattern that unlocks codes on the lens for 60 s. Use 6+ moves.
TOTP_UNLOCK=up up left right down left
