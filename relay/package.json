  "private": true,
  "type": "module",
  "description": "Relay server for Claude Shell: runs Claude Code sessions and connects your apps to the glasses.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
